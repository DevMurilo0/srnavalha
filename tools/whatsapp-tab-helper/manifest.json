{
  "manifest_version": 3,
  "name": "Sr. Navalha — WhatsApp em uma aba",
  "version": "2.1.0",
  "description": "Pesquisa contatos no WhatsApp Web existente sem atualizar a página; funciona no Firefox, Floorp e Chrome.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.whatsapp.com/*",
    "https://srnavalha.vercel.app/*",
    "https://*.vercel.app/*",
    "https://srnavalha.com.br/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.vercel.app/*",
        "https://srnavalha.com.br/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp-page.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "srnavalha-whatsapp-tabs@murilogabriel.com.br",
      "strict_min_version": "121.0"
    }
  }
}
