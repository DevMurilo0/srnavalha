{
  "manifest_version": 3,
  "name": "Sr. Navalha — WhatsApp em uma aba",
  "version": "1.0.0",
  "description": "Reutiliza uma aba já aberta do WhatsApp Web ao clicar em Mensagem no painel Sr. Navalha.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.whatsapp.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://*.vercel.app/*",
        "https://srnavalha.com.br/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "srnavalha-whatsapp-tabs@murilogabriel.com.br",
      "strict_min_version": "121.0"
    }
  }
}
